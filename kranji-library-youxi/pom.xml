    <artifactId>kranji-library-youxi</artifactId>

    <description>
        电子游戏 — games as a subject a child already knows.

        ITS OWN MODULE for the reason the others are: a group is the unit of
        authorship. This one is authored against things that keep changing —
        a map is reworked, a mode leaves the pool — so it is the jar that
        goes stale, and it should be able to go stale without 唐诗 moving.

        It is also the group with the strongest reason to exist. A child who
        will not read a fable will read about the map they played last night,
        and the characters are the same characters.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-reading-model</artifactId>
            <version>${kranji.version}</version>
