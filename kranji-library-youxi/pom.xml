            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.yong.kranji</groupId>
            <artifactId>kranji-reading-testkit</artifactId>
            <version>${kranji.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
